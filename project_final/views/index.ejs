
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Markdown Studio</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link href="https://fonts.googleapis.com/css2?family=Black+Ops+One&family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        :root {
            --background: #080808;
            --panel: #111111;
            --panel-light: #181818;
            --red: #ff3030;
            --red-dark: #b91c1c;
            --text: #f5f5f5;
            --muted: #999999;
            --border: #292929;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: var(--background);
            color: var(--text);
            font-family: 'Inter', sans-serif;
        }

        .navbar {
            background: #0c0c0c;
            border-bottom: 1px solid var(--border);
            padding: 16px 0;
        }

        .brand-name {
            font-family: 'Black Ops One', cursive;
            font-size: 25px;
            color: var(--red);
            letter-spacing: 1px;
            text-decoration: none;
        }

        .brand-name:hover {
            color: #ff6666;
        }

        .brand-icon {
            color: var(--red);
            font-size: 25px;
            margin-right: 8px;
        }

        .nav-label {
            color: var(--muted);
            font-size: 12px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .main-container {
            max-width: 1400px;
            margin: auto;
            padding: 55px 24px 35px;
        }

        .page-heading {
            font-family: 'Black Ops One', cursive;
            font-size: clamp(35px, 5vw, 58px);
            line-height: 1.2;
            color: white;
            letter-spacing: 1px;
            margin-bottom: 16px;
        }

        .page-heading span {
            color: var(--red);
        }

        .page-description {
            color: var(--muted);
            font-size: 15px;
            line-height: 1.8;
            max-width: 650px;
            margin: 0 auto;
        }

        .feature-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 22px;
            padding: 8px 14px;
            color: #ff7777;
            background: rgba(255, 48, 48, 0.08);
            border: 1px solid rgba(255, 48, 48, 0.3);
            border-radius: 30px;
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .feature-badge i {
            font-size: 14px;
        }

        .workspace {
            margin-top: 45px;
        }

        .workspace-panel {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            height: 100%;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.25);
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 18px 20px;
            background: #151515;
            border-bottom: 1px solid var(--border);
        }

        .section-heading {
            font-family: 'Black Ops One', cursive;
            font-size: 19px;
            color: white;
            margin: 0;
            letter-spacing: 0.5px;
        }

        .section-heading i {
            color: var(--red);
            margin-right: 8px;
        }

        .panel-label {
            color: var(--muted);
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .panel-body {
            padding: 0;
        }

        #editor {
            display: block;
            width: 100%;
            min-height: 430px;
            padding: 22px;
            resize: vertical;
            border: none;
            outline: none;
            background: #0d0d0d;
            color: #e8e8e8;
            font-family: Consolas, 'Courier New', monospace;
            font-size: 14px;
            line-height: 1.8;
            tab-size: 4;
        }

        #editor::placeholder {
            color: #666666;
        }

        #editor:focus {
            box-shadow: inset 0 0 0 1px rgba(255, 48, 48, 0.25);
        }

        #preview {
            min-height: 430px;
            padding: 25px;
            overflow-wrap: anywhere;
            background: #101010;
            color: #dddddd;
            line-height: 1.8;
        }

        #preview:empty::before {
            content: "Your converted HTML will appear here...";
            color: #666666;
            font-style: italic;
        }

        #preview h1,
        #preview h2,
        #preview h3,
        #preview h4,
        #preview h5,
        #preview h6 {
            color: #ffffff;
            margin-top: 22px;
            margin-bottom: 12px;
        }

        #preview h1 {
            font-size: 30px;
            border-bottom: 2px solid var(--red);
            padding-bottom: 10px;
        }

        #preview h2 {
            font-size: 24px;
        }

        #preview h3 {
            font-size: 20px;
        }

        #preview p {
            margin-bottom: 16px;
        }

        #preview a {
            color: #ff5555;
            text-decoration: underline;
        }

        #preview a:hover {
            color: #ff8888;
        }

        #preview ul,
        #preview ol {
            padding-left: 25px;
        }

        #preview li {
            margin-bottom: 6px;
        }

        #preview blockquote {
            margin: 18px 0;
            padding: 10px 18px;
            border-left: 4px solid var(--red);
            background: #191919;
            color: #bbbbbb;
        }

        #preview code {
            padding: 3px 6px;
            border-radius: 4px;
            background: #252525;
            color: #ff7777;
            font-family: Consolas, monospace;
        }

        #preview pre {
            padding: 16px;
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: #080808;
        }

        #preview pre code {
            padding: 0;
            background: transparent;
            color: #eeeeee;
        }

        #preview img {
            max-width: 100%;
            height: auto;
        }

        #preview hr {
            border-color: #444444;
        }

        #preview table {
            width: 100%;
            border-collapse: collapse;
            margin: 16px 0;
        }

        #preview th,
        #preview td {
            padding: 10px;
            border: 1px solid #383838;
            text-align: left;
        }

        #preview th {
            background: #202020;
            color: white;
        }

        .btn-convert {
            background: var(--red);
            color: white;
            border: 1px solid var(--red);
            border-radius: 6px;
            padding: 10px 18px;
            font-size: 13px;
            font-weight: 700;
            transition: 0.2s;
        }

        .btn-convert:hover {
            background: #d91f1f;
            border-color: #d91f1f;
            color: white;
            transform: translateY(-1px);
        }

        .btn-download {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: transparent;
            color: #eeeeee;
            border: 1px solid #444444;
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: 0.2s;
        }

        .btn-download:hover {
            background: var(--red);
            border-color: var(--red);
            color: white;
        }

        .btn-download:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

        #status {
            min-height: 22px;
            margin-top: 16px;
            color: var(--muted);
            font-size: 13px;
            text-align: center;
        }

        #status.success {
            color: #4ade80;
        }

        #status.error {
            color: #ff5555;
        }

        .features {
            margin-top: 55px;
        }

        .feature-card {
            height: 100%;
            padding: 22px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: #101010;
            transition: 0.2s;
        }

        .feature-card:hover {
            border-color: #6b2020;
            transform: translateY(-3px);
        }

        .feature-icon {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 42px;
            height: 42px;
            margin-bottom: 16px;
            border-radius: 8px;
            background: rgba(255, 48, 48, 0.12);
            color: var(--red);
            font-size: 20px;
        }

        .feature-title {
            color: white;
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .feature-text {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.7;
            margin: 0;
        }

        footer {
            margin-top: 60px;
            padding: 24px 15px;
            border-top: 1px solid var(--border);
            background: #0c0c0c;
            text-align: center;
        }

        .footer-text {
            color: #777777;
            font-size: 12px;
            margin: 0;
        }

        .footer-text span {
            color: var(--red);
        }

        @media (max-width: 767px) {
            .main-container {
                padding: 35px 15px 25px;
            }

            .page-heading {
                font-size: 36px;
            }

            .workspace {
                margin-top: 30px;
            }

            #editor,
            #preview {
                min-height: 320px;
            }

            .panel-header {
                padding: 15px;
            }

            #editor,
            #preview {
                padding: 16px;
            }

            .section-heading {
                font-size: 16px;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar">
        <div class="container">
            <a href="/" class="brand-name">
                <i class="bi bi-braces-asterisk brand-icon"></i>Markdown Studio
            </a>

            <span class="nav-label d-none d-sm-inline">
                Markdown to HTML
            </span>
        </div>
    </nav>

    <main class="main-container">

        <section class="text-center">
            <h1 class="page-heading">
                WRITE <span>MARKDOWN.</span><br>
                BUILD HTML.
            </h1>

            <p class="page-description">
                A simple workspace to write Markdown and convert it into HTML.
                Write your content, preview the result, and download your HTML file.
            </p>

            <div class="feature-badge">
                <i class="bi bi-lightning-charge-fill"></i>
                Simple. Fast. Developer Friendly.
            </div>
        </section>

        <section class="workspace">
            <div class="row g-4">

                <!-- Markdown Editor -->
                <div class="col-12 col-lg-6">
                    <div class="workspace-panel">

                        <div class="panel-header">
                            <h2 class="section-heading">
                                <i class="bi bi-pencil-square"></i>Markdown Editor
                            </h2>

                            <span class="panel-label">Input</span>
                        </div>

                        <div class="panel-body">
                            <textarea
                                id="editor"
                                spellcheck="false"
                                placeholder="# Start writing Markdown..."
                            ><%= sample %></textarea>
                        </div>

                    </div>
                </div>

                <!-- HTML Preview -->
                <div class="col-12 col-lg-6">
                    <div class="workspace-panel">

                        <div class="panel-header">
                            <h2 class="section-heading">
                                <i class="bi bi-window"></i>HTML Preview
                            </h2>

                            <button
                                type="button"
                                id="downloadBtn"
                                class="btn-download"
                                disabled
                            >
                                <i class="bi bi-download"></i> Download HTML
                            </button>
                        </div>

                        <div class="panel-body">
                            <div id="preview"></div>
                        </div>

                        <div class="editor-footer">
                            <span class="editor-hint">
                                <i class="bi bi-check-circle"></i>
                                Converted output
                            </span>

                            <span class="panel-label">HTML</span>
                        </div>

                    </div>
                </div>

            </div>

            <div id="status" role="status" aria-live="polite">
                Ready to convert your Markdown.
            </div>

            <div class="text-center mt-3">
                <button
                    type="button"
                    id="convertBtn"
                    class="btn-convert"
                >
                    <i class="bi bi-arrow-repeat me-2"></i>
                    Convert to HTML
                </button>
            </div>
        </section>

        <!-- Features -->
        <section class="features">
            <div class="text-center mb-4">
                <h2 class="section-heading">WHAT YOU CAN DO</h2>
                <p class="page-description mt-2">
                    Everything you need for a simple Markdown workflow.
                </p>
            </div>

            <div class="row g-3">

                <div class="col-12 col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-markdown"></i>
                        </div>

                        <h3 class="feature-title">Write Markdown</h3>

                        <p class="feature-text">
                            Write headings, paragraphs, lists, links, and
                            formatted text in a simple editor.
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-code-slash"></i>
                        </div>

                        <h3 class="feature-title">Convert to HTML</h3>

                        <p class="feature-text">
                            Convert your Markdown into HTML using the
                            converter connected to this application.
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-file-earmark-arrow-down"></i>
                        </div>

                        <h3 class="feature-title">Download Output</h3>

                        <p class="feature-text">
                            Download the converted HTML output and use it
                            in your own web projects.
                        </p>
                    </div>
                </div>

            </div>
        </section>

    </main>

    <footer>
        <p class="footer-text">
            Built with <span>♥</span> using C++, HTML, CSS and JavaScript
        </p>

        <p class="footer-text mt-2">
            Markdown Studio &copy; <%= new Date().getFullYear() %>
        </p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/app.js"></script>

</body>
</html>
